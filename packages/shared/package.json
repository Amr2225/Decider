{
  "name": "@decider/shared",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./prisma/*": {
      "types": "./dist/prisma/*.d.ts",
      "default": "./dist/prisma/*.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@prisma/client": "^7.7.0"
  }
}